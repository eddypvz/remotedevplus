# Unit plantilla: `remotedevplus@eddy.service` corre el agente COMO el usuario eddy.
#
# Esto es lo que hace innecesario un supervisor privilegiado. El aislamiento
# entre devs no sale de código dentro del agente, sale de correr un agente por
# dev: cada uno con sus archivos, sus llaves SSH, sus credenciales de Claude y
# sus procesos separados por el sistema operativo. El agente sigue sin privilegios.
#
#   sudo install -m644 deploy/remotedevplus@.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now remotedevplus@eddy
#
# El puerto sale de la instancia para que varios agentes convivan; ajustá el
# mapa a mano o usá un EnvironmentFile por usuario.

[Unit]
Description=remotedevplus (agente de %i)
After=network.target

[Service]
Type=simple
User=%i
WorkingDirectory=/opt/remotedevplus
Environment=NODE_ENV=production
EnvironmentFile=-/etc/remotedevplus/%i.env
ExecStart=/usr/bin/node /opt/remotedevplus/apps/agent/src/cli.js serve
Restart=on-failure
RestartSec=2

# El agente solo necesita leer y escribir lo que el dev ya podía tocar.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
